{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-baltics",
  "account_id": "f9ee5f3ceb5658869b332ed8a0ed0a72",
  "compatibility_date": "2026-09-30",
  "main": "worker.mjs",
  "assets": {
    "directory": "./public-baltics",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cryptobaltics.org",
      "custom_domain": true
    },
    {
      "pattern": "www.cryptobaltics.org",
      "custom_domain": true
    }
  ]
}
