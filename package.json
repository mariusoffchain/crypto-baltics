{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "build": "node scripts/build-release.mjs",
    "preview": "python3 -m http.server 8767 --bind 127.0.0.1 --directory public-build",
    "refresh:merchants": "node scripts/refresh-snapshot.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:baltics": "SITE_PROFILE=baltics node scripts/build-release.mjs",
    "preview:baltics": "python3 scripts/preview.py --directory public-baltics --port 8775",
    "refresh:baltics": "SITE_PROFILE=baltics node scripts/refresh-snapshot.mjs",
    "build:crypto": "node scripts/sync-research-events.mjs && SITE_PROFILE=baltics node scripts/build-release.mjs && node scripts/build-research.mjs && node directory/build-directory.mjs",
    "preview:crypto": "python3 scripts/preview.py --directory public-baltics --port 8777",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "wrangler": "4.144.0"
  },
  "name": "crypto-baltics",
  "version": "1.0.0",
  "description": "An open-source Bitcoin community map and events website",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
